# Copy to .env.local and fill in. Never commit real values.

# Server-only. Used by POST /api/extract-notice. Never exposed to the browser.
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-fable-5-1 when unset.
ANTHROPIC_MODEL=claude-fable-5-1

# "true" shows a separate "Load sample notice" control whose results are labelled "Demo data".
# It never replaces a failed AI extraction. Inlined at build time, so restart after changing it.
NEXT_PUBLIC_ENABLE_DEMO_FALLBACK=false

# Optional, server-only. Community delivery requests (POST /api/delivery-request) notify this
# Telegram chat with a short English brief for the volunteers (a REAL message to real people).
# Only when either is blank does the form answer "Demo only. No real request will be sent."
# Token: @BotFather → /newbot. Chat id: message the bot, then open
# https://api.telegram.org/bot<TOKEN>/getUpdates and copy result[].message.chat.id (groups are negative).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional. Volunteer sign-ups (POST /api/volunteer) carry the volunteer's own phone number, so they
# go here (your personal chat with the bot) instead of the group. Blank = falls back to TELEGRAM_CHAT_ID.
TELEGRAM_OPERATOR_CHAT_ID=
